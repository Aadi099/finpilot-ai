generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountKind {
  BANK
  CASH
  CREDIT_CARD
  LOAN
  FIXED_DEPOSIT
  PROVIDENT_FUND
  BROKERAGE
  CRYPTO_WALLET
  CUSTOM_ASSET
  CUSTOM_LIABILITY
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum PaymentMethod {
  UPI
  CREDIT_CARD
  DEBIT_CARD
  CASH
  BANK_TRANSFER
  AUTO_DEBIT
  BROKERAGE_CREDIT
  OTHER
}

enum InvestmentKind {
  INDIAN_STOCK
  INTERNATIONAL_STOCK
  MUTUAL_FUND
  ETF
  BOND
  FIXED_DEPOSIT
  GOLD
  REAL_ESTATE
  CRYPTO
  EPF
  PPF
  NPS
  CUSTOM
}

enum InvestmentTransactionType {
  BUY
  SELL
  DIVIDEND
  INTEREST
  BONUS
  SPLIT
  FEE
}

enum BillStatus {
  UPCOMING
  PAID
  OVERDUE
  SKIPPED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String?
  imageUrl     String?
  workspaces   WorkspaceMember[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Workspace {
  id                 String             @id @default(cuid())
  name               String
  baseCurrency       String             @default("INR")
  members            WorkspaceMember[]
  accounts           Account[]
  categories         Category[]
  tags               Tag[]
  transactions       Transaction[]
  budgets            Budget[]
  investments        Investment[]
  goals              Goal[]
  loans              Loan[]
  bills              Bill[]
  portfolioSnapshots PortfolioHistory[]
  monthlySnapshots    MonthlySnapshot[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        String    @default("owner")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, workspaceId])
}

model Account {
  id             String        @id @default(cuid())
  workspaceId    String
  name           String
  kind           AccountKind
  institution    String?
  currency       String        @default("INR")
  openingBalance Decimal       @default(0) @db.Decimal(18, 2)
  currentBalance Decimal       @default(0) @db.Decimal(18, 2)
  isArchived     Boolean       @default(false)
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions   Transaction[] @relation("AccountTransactions")
  transfersOut   Transaction[] @relation("TransferFromAccount")
  transfersIn    Transaction[] @relation("TransferToAccount")
  loan           Loan?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([workspaceId, kind])
}

model Category {
  id          String        @id @default(cuid())
  workspaceId String
  name        String
  parentId    String?
  color       String?
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent      Category?     @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[]    @relation("CategoryHierarchy")
  transactions Transaction[]
  budgets     Budget[]

  @@unique([workspaceId, name, parentId])
}

model Tag {
  id           String        @id @default(cuid())
  workspaceId  String
  name         String
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions TransactionTag[]

  @@unique([workspaceId, name])
}

model Transaction {
  id                    String          @id @default(cuid())
  workspaceId           String
  accountId             String
  categoryId            String?
  transferFromAccountId String?
  transferToAccountId   String?
  type                  TransactionType
  amount                Decimal         @db.Decimal(18, 2)
  currency              String          @default("INR")
  merchant              String
  counterparty          String?
  paymentMethod         PaymentMethod   @default(UPI)
  description           String?
  notes                 String?
  occurredAt            DateTime
  paidAt                DateTime?
  creditStatementMonth  String?
  receiptUrl            String?
  workspace             Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account               Account         @relation("AccountTransactions", fields: [accountId], references: [id])
  category              Category?       @relation(fields: [categoryId], references: [id])
  transferFromAccount   Account?        @relation("TransferFromAccount", fields: [transferFromAccountId], references: [id])
  transferToAccount     Account?        @relation("TransferToAccount", fields: [transferToAccountId], references: [id])
  tags                  TransactionTag[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([workspaceId, occurredAt])
  @@index([workspaceId, paidAt])
  @@index([workspaceId, type])
}

model MonthlySnapshot {
  id                     String    @id @default(cuid())
  workspaceId            String
  month                  String
  salaryExpected         Decimal   @default(0) @db.Decimal(18, 2)
  salaryReceived         Decimal   @default(0) @db.Decimal(18, 2)
  cashOpening            Decimal   @default(0) @db.Decimal(18, 2)
  investmentValueOpening Decimal   @default(0) @db.Decimal(18, 2)
  creditCardDueOpening   Decimal   @default(0) @db.Decimal(18, 2)
  notes                  String?
  workspace              Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([workspaceId, month])
}

model TransactionTag {
  transactionId String
  tagId         String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
}

model Budget {
  id          String    @id @default(cuid())
  workspaceId String
  categoryId  String
  name        String
  periodStart DateTime
  periodEnd   DateTime
  limitAmount Decimal   @db.Decimal(18, 2)
  rollover    Boolean   @default(false)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category    Category  @relation(fields: [categoryId], references: [id])

  @@index([workspaceId, periodStart, periodEnd])
}

model Investment {
  id             String                  @id @default(cuid())
  workspaceId    String
  symbol         String?
  name           String
  kind           InvestmentKind
  currency       String                  @default("INR")
  units          Decimal                 @default(0) @db.Decimal(24, 8)
  averagePrice   Decimal                 @default(0) @db.Decimal(18, 4)
  investedAmount Decimal                 @default(0) @db.Decimal(18, 2)
  currentValue   Decimal                 @default(0) @db.Decimal(18, 2)
  sector         String?
  geography      String?
  workspace      Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions   InvestmentTransaction[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([workspaceId, kind])
  @@index([workspaceId, symbol])
}

model InvestmentTransaction {
  id           String                    @id @default(cuid())
  investmentId String
  type         InvestmentTransactionType
  units        Decimal?                  @db.Decimal(24, 8)
  price        Decimal?                  @db.Decimal(18, 4)
  amount       Decimal                   @db.Decimal(18, 2)
  occurredAt   DateTime
  notes        String?
  investment   Investment                @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@index([investmentId, occurredAt])
}

model Goal {
  id            String    @id @default(cuid())
  workspaceId   String
  name          String
  targetAmount  Decimal   @db.Decimal(18, 2)
  currentAmount Decimal   @default(0) @db.Decimal(18, 2)
  targetDate    DateTime?
  priority      Int       @default(3)
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Loan {
  id             String    @id @default(cuid())
  workspaceId    String
  accountId      String    @unique
  name           String
  principal      Decimal   @db.Decimal(18, 2)
  outstanding    Decimal   @db.Decimal(18, 2)
  interestRate   Decimal   @db.Decimal(7, 4)
  emiAmount      Decimal?  @db.Decimal(18, 2)
  startDate      DateTime
  endDate        DateTime?
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account        Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model Bill {
  id          String     @id @default(cuid())
  workspaceId String
  name        String
  amount      Decimal    @db.Decimal(18, 2)
  dueDate     DateTime
  status      BillStatus @default(UPCOMING)
  recurringRule String?
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, dueDate, status])
}

model PortfolioHistory {
  id             String    @id @default(cuid())
  workspaceId    String
  snapshotDate   DateTime
  investedAmount Decimal   @db.Decimal(18, 2)
  currentValue   Decimal   @db.Decimal(18, 2)
  cashValue      Decimal   @default(0) @db.Decimal(18, 2)
  allocation     Json
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, snapshotDate])
}
